# Copy to .env and fill in. .env is git-ignored: it holds your API key.

# Immich server, and an API key with: person.read, asset.read, face.read, asset.view
IMMICH_URL=http://immich.example.lan:2283
IMMICH_API_KEY=

# Immich machine-learning server (the immich-machine-learning container, port 3003)
IMMICH_ML_URL=http://immich.example.lan:3003

# Your existing CodeProject.AI server. CPAI_URL is used by ImmichEye's own fallback;
# CPAI_UPSTREAM (host:port, no scheme) by the nginx router.
CPAI_URL=http://cpai.example.lan:32168
CPAI_UPSTREAM=cpai.example.lan:32168

# Port Blue Iris connects to, and the admin endpoints' address and port (127.0.0.1 = this host only)
IMMICHEYE_PORT=32170
IMMICHEYE_ADMIN_BIND=127.0.0.1
IMMICHEYE_ADMIN_PORT=8000

# Who to recognise: comma-separated Immich names. Empty = every named, non-hidden person.
IMMICHEYE_PEOPLE=
# Blue Iris labels: first = first name (cal), or full name where first names clash;
# full = always the full name (cal_smith). Words joined with underscores.
IMMICHEYE_LABELS=first
# lower (cal_smith) or title (Cal_Smith)
IMMICHEYE_LABEL_CASE=lower
# Between words: underscore (cal_smith) or space (cal smith)
IMMICHEYE_LABEL_SEPARATOR=underscore
# Immich name -> Blue Iris label for particular people, as JSON; overrides the above.
IMMICHEYE_NAME_MAP={}

# Must match the facial-recognition model in Immich's settings
IMMICHEYE_MODEL=buffalo_l

# Gallery: the largest faces among each person's most recent photos
IMMICHEYE_ASSETS_PER_PERSON=250
IMMICHEYE_FACES_PER_PERSON=40
IMMICHEYE_MIN_FACE_PX=60
IMMICHEYE_REFRESH_MINUTES=360

# Matching (cosine similarity; see README "Tuning")
IMMICHEYE_DETECT_MIN_SCORE=0.7
IMMICHEYE_MATCH_THRESHOLD=0.40
IMMICHEYE_MATCH_MARGIN=0.05
IMMICHEYE_TOP_K=3
# Also embed reference faces shrunk to these widths, to match small CCTV faces (empty = off)
IMMICHEYE_LOWRES_PX=32,48
# Also search frames larger than this in overlapping tiles of this size (0 = off)
IMMICHEYE_TILE_PX=1280
IMMICHEYE_LOG_RECOGNITIONS=1
# Keep crops of the last N faces Blue Iris sent, in data/faces, for checking results (0 = off)
IMMICHEYE_SAVE_FACES=0

# Blue Iris lists only one image's faces in an alert's memo. 1 = every reply in an alert also
# carries names found in its other images; a nameless reply waits for one until HOLD_MS after
# the alert's first image. See README "Names in alerts".
IMMICHEYE_ALERT_SHARE=0
IMMICHEYE_ALERT_HOLD_MS=3000

# Late names: add names that turn up after an alert to its memo, through Blue Iris's JSON API.
# Needs a Blue Iris admin user. Empty URL = off. See README "Late names".
IMMICHEYE_BLUEIRIS_URL=
IMMICHEYE_BLUEIRIS_USER=
IMMICHEYE_BLUEIRIS_PASSWORD=
IMMICHEYE_LATE_NAMES_S=60

# Face events: POST every detected face (embedding, crop, result) to another service, e.g. a
# visitor log. Empty URL = off. Cameras: short names to send, empty = all. FRAME_PX: also send
# the whole frame scaled to this long side (0 = off). See README "Face events".
IMMICHEYE_EVENTS_URL=
IMMICHEYE_EVENTS_TOKEN=
IMMICHEYE_EVENTS_CAMERAS=
IMMICHEYE_EVENTS_FRAME_PX=0

# CodeProject.AI's face database: off | managed | exclusive (see README)
IMMICHEYE_CPAI_SYNC=managed
IMMICHEYE_CPAI_PROTOTYPES=4
# When ImmichEye or Immich ML is down: 0 = report no face, 1 = let CodeProject.AI answer
IMMICHEYE_CPAI_FALLBACK=0
