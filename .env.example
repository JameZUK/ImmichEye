# Copy to .env and fill in. .env is git-ignored: it holds your API key.

# Immich server, and an API key with: person.read, asset.read, face.read, asset.view
IMMICH_URL=http://immich.example.lan:2283
IMMICH_API_KEY=

# Immich machine-learning server (the immich-machine-learning container, port 3003)
IMMICH_ML_URL=http://immich.example.lan:3003

# Your existing CodeProject.AI server. CPAI_URL is used by ImmichEye's own fallback;
# CPAI_UPSTREAM (host:port, no scheme) by the nginx router.
CPAI_URL=http://cpai.example.lan:32168
CPAI_UPSTREAM=cpai.example.lan:32168

# Port Blue Iris connects to, and the admin endpoints' address and port (127.0.0.1 = this host only)
IMMICHEYE_PORT=32170
IMMICHEYE_ADMIN_BIND=127.0.0.1
IMMICHEYE_ADMIN_PORT=8000

# Who to recognise: comma-separated Immich names. Empty = every named, non-hidden person.
IMMICHEYE_PEOPLE=
# Immich name -> Blue Iris label, as JSON. Default label is the lower-case first name.
IMMICHEYE_NAME_MAP={}

# Must match the facial-recognition model in Immich's settings
IMMICHEYE_MODEL=buffalo_l

# Gallery: the largest faces among each person's most recent photos
IMMICHEYE_ASSETS_PER_PERSON=250
IMMICHEYE_FACES_PER_PERSON=40
IMMICHEYE_MIN_FACE_PX=60
IMMICHEYE_REFRESH_MINUTES=360

# Matching (cosine similarity; see README "Tuning")
IMMICHEYE_DETECT_MIN_SCORE=0.7
IMMICHEYE_MATCH_THRESHOLD=0.40
IMMICHEYE_MATCH_MARGIN=0.05
IMMICHEYE_TOP_K=3
IMMICHEYE_LOG_RECOGNITIONS=1
# Keep crops of the last N faces Blue Iris sent, in data/faces, for checking results (0 = off)
IMMICHEYE_SAVE_FACES=0

# CodeProject.AI's face database: off | managed | exclusive (see README)
IMMICHEYE_CPAI_SYNC=managed
IMMICHEYE_CPAI_PROTOTYPES=4
# When ImmichEye or Immich ML is down: 0 = report no face, 1 = let CodeProject.AI answer
IMMICHEYE_CPAI_FALLBACK=0
