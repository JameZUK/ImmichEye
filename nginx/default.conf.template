# Blue Iris points its AI server at this. Face recognition goes to ImmichEye;
# everything else (object detection, plates, the status page) goes straight to
# CodeProject.AI untouched. If ImmichEye is down, face calls get a "no face" reply,
# or with IMMICHEYE_CPAI_FALLBACK=1 go to CodeProject.AI.

upstream cpai {
    server ${CPAI_UPSTREAM};
    keepalive 16;
}

server {
    listen 8080;
    client_max_body_size 32m;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_request_buffering on;

    # Resolve ImmichEye per request (Docker's DNS), so this router starts and keeps
    # serving object detection even while the immicheye container is down.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $faces http://immicheye:8000;

    location ~ ^/v1/vision/face/(recognize|list)$ {
        proxy_pass $faces;
        proxy_connect_timeout 2s;
        proxy_read_timeout 30s;
        proxy_intercept_errors on;
        error_page 502 503 504 = @faces_fallback_${IMMICHEYE_CPAI_FALLBACK};
    }

    location @faces_fallback_1 {
        proxy_pass http://cpai;
    }

    location @faces_fallback_0 {
        default_type application/json;
        return 200 '{"success":false,"error":"ImmichEye unavailable","code":500,"moduleId":"FaceProcessing"}';
    }

    location / {
        proxy_pass http://cpai;
        proxy_read_timeout 120s;
    }
}
